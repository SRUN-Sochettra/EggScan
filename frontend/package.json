{
  "name": "eggscan-cloudflare",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:emoji && vite build && npm run check:dist-assets && npm run check:dist-secrets",
    "deploy:production": "node scripts/deploy-production.mjs",
    "check:emoji": "node scripts/assert-no-emojis.mjs",
    "check:dist-assets": "node scripts/assert-production-assets.mjs",
    "check:dist-secrets": "node scripts/assert-no-secrets-in-dist.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply eggscan --local",
    "db:migrate:remote": "wrangler d1 migrations apply eggscan --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "hono": "^4.9.2",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.7",
    "@cloudflare/workers-types": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.30.0"
  }
}